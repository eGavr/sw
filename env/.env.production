LOG_LEVEL=log,error,fatal
# OTEL_ENABLED=true

# Host and credentials are injected by the deployment (process env overrides this file);
# the values below are placeholders so the service is fully configured.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sw
POSTGRES_PASSWORD=sw
POSTGRES_DATABASE=sw

AUTH_STRATEGY=local

COMPUTE_PROVIDER=docker
# Stock selenium image — the heartbeat agent is fetched from the control plane at startup (not baked in),
# so no custom image and no rebuild per browser/version. Native amd64 host → real Chrome; pin a version
# tag as needed (e.g. selenium/standalone-chrome:148.0).
COMPUTE_DOCKER_IMAGE=selenium/standalone-chrome:latest
# From inside the container the callback API is reached via host.docker.internal by default; in a real
# deployment set this to the internal API's cluster-reachable URL.
# COMPUTE_DOCKER_INTERNAL_URL=http://internal-api:3002
# Host address the browser node is published at, encoded into session ids for stateless routing.
# COMPUTE_DOCKER_ADVERTISE_HOST=127.0.0.1

API_PORT=3000
WD_PORT=3001
INTERNAL_PORT=3002
# Shared secret the in-container agent sends to the internal callback API (injected by the deployment).
INTERNAL_API_SECRET=change-me

# Worker reaper: sweep interval, per-phase provisioning lease timeouts, retry budget before a stuck
# environment fails permanently. Uncomment to override the built-in defaults.
# WORKER_REAPER_INTERVAL_MS=10000
# WORKER_STARTING_TIMEOUT_MS=15000
# WORKER_PREPARING_TIMEOUT_MS=120000
# WORKER_PROVISION_MAX_ATTEMPTS=3

# Worker GC: sweep interval, TTL before a failed environment is hard-deleted, and the heartbeat
# freshness window used to decide a deleting environment's container is gone.
# WORKER_GC_INTERVAL_MS=30000
# WORKER_FAILED_TTL_MS=3600000
# HEARTBEAT_FRESHNESS_MS=6000
