LOG_LEVEL=log,error,fatal
# OTEL_ENABLED=true

# Host and credentials are injected by the deployment (process env overrides this file);
# the values below are placeholders so the service is fully configured.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sw
POSTGRES_PASSWORD=sw
POSTGRES_DATABASE=sw

AUTH_STRATEGY=local

COMPUTE_PROVIDER=docker
# Native amd64 host → real Chrome; pin a version tag as needed (e.g. selenium/standalone-chrome:148.0).
COMPUTE_DOCKER_IMAGE=selenium/standalone-chrome:latest

API_PORT=3000
WD_PORT=3001
