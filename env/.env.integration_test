LOG_LEVEL=fatal

# Integration tests TRUNCATE every table between cases, so they must target an isolated database.
# On this machine 5432 is taken by another service; our dedicated Postgres runs on 5433.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=sw
POSTGRES_PASSWORD=sw
POSTGRES_DATABASE=sw

AUTH_STRATEGY=local

# In-memory compute so environment tests need no Docker.
COMPUTE_PROVIDER=local
