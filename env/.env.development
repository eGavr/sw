LOG_LEVEL=verbose,debug,log,warn,error,fatal
# OTEL_ENABLED=true

# 5432 is taken by another local service on this machine, so our dev Postgres runs on 5433.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=sw
POSTGRES_PASSWORD=sw
POSTGRES_DATABASE=sw

AUTH_STRATEGY=local

COMPUTE_PROVIDER=docker
# arm64 (Apple Silicon): Chromium via seleniarm; real Chrome (amd64) crashes under QEMU emulation.
COMPUTE_DOCKER_IMAGE=seleniarm/standalone-chromium:latest
# COMPUTE_DOCKER_PORT=4444
# COMPUTE_DOCKER_SESSION_TIMEOUT=300
# Pin the container arch (e.g. run an amd64 image on arm):
# COMPUTE_DOCKER_PLATFORM=linux/amd64
# Custom base image that installs the browser at startup (reads SW_BROWSER_NAME / SW_BROWSER_VERSION):
# COMPUTE_DOCKER_BASE_IMAGE=sw/browser-base:latest

API_PORT=3000
WD_PORT=3001

# Worker reaper: how often it sweeps, the per-phase provisioning lease timeouts, and the retry budget
# before a stuck environment fails permanently.
# WORKER_REAPER_INTERVAL_MS=10000
# WORKER_STARTING_TIMEOUT_MS=15000
# WORKER_PREPARING_TIMEOUT_MS=120000
# WORKER_PROVISION_MAX_ATTEMPTS=3
