LOG_LEVEL=fatal

# Integration tests TRUNCATE every table between cases, so they must target an isolated database.
# 5432 and 5433 are both taken on this machine by other projects' databases (the
# second one by an embedded Postgres that binds the loopback address specifically and
# would swallow our connections), so ours is published on 5435.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_USER=sw
POSTGRES_PASSWORD=sw
POSTGRES_DATABASE=sw_test

AUTH_STRATEGY=local

# Shared secret guarding the internal callback API (the agent → /internal).
INTERNAL_API_SECRET=test-internal-secret

# Allocation retry off in tests: the 409/400 refusal assertions expect an immediate answer.
SESSION_ALLOCATION_RETRY_BUDGET_MS=0

# Published delegation identities (stub ids) so the catalogue/storageDelegation surfaces are testable.
YC_DELEGATION_COMPUTE_SA_ID=aje-test-compute
YC_DELEGATION_STORAGE_SA_ID=aje-test-storage

# The reserved catalog project: a known admin identity the suites act as, and a first-boot seed with
# the pinned full versions their loose asks resolve against (the catalog itself lives in the database).
CATALOG_ADMIN_EXTERNAL_IDS=catalog-admin
CATALOG_SEED_FILE=test/integration/fixtures/catalog-seed.json
