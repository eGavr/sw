LOG_LEVEL=verbose,debug,log,warn,error,fatal
# OTEL_ENABLED=true

# 5432 and 5433 are both taken on this machine by other projects' databases (the
# second one by an embedded Postgres that binds the loopback address specifically and
# would swallow our connections), so ours is published on 5435.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_USER=sw
POSTGRES_PASSWORD=sw
POSTGRES_DATABASE=sw

# local = dev stub (any bearer token authenticates). Switch to `oidc` and set OIDC_ISSUER / OIDC_AUDIENCE /
# OIDC_JWKS_URI (+ optional OIDC_GROUPS_CLAIM, default `groups`) to verify real signed tokens.
AUTH_STRATEGY=local

# Clouds this install offers (comma-separated). Dev exposes only `local` (the operator's docker); a hosted
# install lists the real clouds it runs on. Unset = all known types. Drives GET /v1/cloudTypes and the UI
# Connect dropdown, so `yandex-cloud` (non-functional locally) is not offered here.
CLOUD_CATALOG=local,self-hosted

# Docker adapter (the `local` cloud): install defaults for provisioning ubuntu/container environments.
# The linux base image (images/linux-base, one per ubuntu version — `{version}` = platform.version) turns
# itself into a browser node at start: node script, wd door and heartbeat agent come from the control
# plane, the browser and its chromedriver are catalog artifacts pulled through it. No rebuild per browser.
COMPUTE_DOCKER_BASE_IMAGE=sw-linux-base:{version}
# Pin the container arch when the delivered browser needs one. Chrome for Testing ships linux/amd64 only
# and crashes under QEMU on Apple Silicon — there, build the base image for arm64 and register an arm64
# browser build as a custom application (see images/linux-base/README.md); amd64 hosts run the catalog's
# chrome natively.
# COMPUTE_DOCKER_PLATFORM=linux/amd64
# COMPUTE_DOCKER_PORT=4444
# Headless display geometry (also the video record size):
# COMPUTE_DOCKER_SCREEN_WIDTH=1360
# COMPUTE_DOCKER_SCREEN_HEIGHT=1020
# Host address the browser node is published at (encoded into session ids for stateless routing).
# COMPUTE_DOCKER_ADVERTISE_HOST=127.0.0.1
# URL the in-container agent calls back on; defaults to host.docker.internal:<INTERNAL_PORT>.
# COMPUTE_DOCKER_INTERNAL_URL=http://host.docker.internal:3002

API_PORT=3000
WD_PORT=3001
INTERNAL_PORT=3002
# Shared secret the in-container agent sends to the internal callback API.
INTERNAL_API_SECRET=dev-internal-secret

# Worker reaper: how often it sweeps, the per-phase provisioning lease timeouts, and the retry budget
# before a stuck environment fails permanently.
# WORKER_REAPER_INTERVAL_MS=10000
# WORKER_STARTING_TIMEOUT_MS=15000
# WORKER_PREPARING_TIMEOUT_MS=120000
# WORKER_PROVISION_MAX_ATTEMPTS=3

# Worker GC: sweep interval, TTL before a failed environment is hard-deleted, and the heartbeat
# freshness window used to decide a deleting environment's container is gone.
# WORKER_GC_INTERVAL_MS=30000
# WORKER_FAILED_TTL_MS=3600000
# HEARTBEAT_FRESHNESS_MS=6000

# Local artifact storage: session logs/video land as plain files under LOG_STORAGE_FS_ROOT (shared by
# api/wd/internal processes), and every project gets a default destination — uploads and read-back
# just work in development without configuring a bucket.
LOG_STORAGE=fs
# LOG_STORAGE_FS_ROOT=.dev-storage

# Session allocation retries a transient shortage (everything momentarily busy/reserved -> 409) for
# this budget, so a caller who just freed an environment gets a session instead of a 409 to retry by
# hand. Default = the heartbeat freshness window (covers one heartbeat interval). Backoff between tries.
# SESSION_ALLOCATION_RETRY_BUDGET_MS=6000
# SESSION_ALLOCATION_RETRY_BACKOFF_MS=200

# Who may grow the install catalog (the reserved `catalog` project): comma-separated external ids —
# under OIDC the token's `sub`. The local Keycloak realm mints alice's sub at setup, so after
# docs/deploy/local-oidc-keycloak/setup-realm.sh put YOUR alice's sub here (decode a token's `sub`).
# Not the untracked .env: ConfigModule loads .env first for every NODE_ENV, integration tests included.
CATALOG_ADMIN_EXTERNAL_IDS=3b457be9-b2f3-47d5-a6c9-5580330da2fb
