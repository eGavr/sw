# Auth.js (NextAuth v5) — dashboard BFF. Copy to .env.local and fill from the local Keycloak:
#   1) start Keycloak:  (docs/deploy/local-oidc-keycloak)  docker compose up -d
#   2) bash docs/deploy/local-oidc-keycloak/setup-realm.sh          # realm sw + users alice/bob/carol
#   3) bash docs/deploy/local-oidc-keycloak/setup-web-client.sh     # prints AUTH_KEYCLOAK_* below
#   4) AUTH_SECRET:  openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=sw-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8085/realms/sw
